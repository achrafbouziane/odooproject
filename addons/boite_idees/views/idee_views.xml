<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_boite_idee" model="ir.actions.act_window">
        <field name="name">Idées</field>
        <field name="res_model">boite.idee</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_idee_root" name="Boîte à Idées" sequence="10"/>
    <menuitem id="menu_idee_gestion" name="Gestion" parent="menu_idee_root" action="action_boite_idee"/>

    <record id="view_idee_tree" model="ir.ui.view">
        <field name="name">boite.idee.tree</field>
        <field name="model">boite.idee</field>
        <field name="arch" type="xml">
            <tree decoration-success="statut=='approuvee'" decoration-info="statut=='soumise'">
                <field name="name"/>
                <field name="categorie"/>
                <field name="auteur"/>
                <field name="date_creation"/>
                <field name="statut" widget="badge"/>
                <field name="vote_count"/>
            </tree>
        </field>
    </record>

    <record id="view_idee_form" model="ir.ui.view">
        <field name="name">boite.idee.form</field>
        <field name="model">boite.idee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="statut" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="auteur"/>
                            <field name="categorie"/>
                        </group>
                        <group>
                            <field name="date_creation"/>
                            <field name="vote_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>